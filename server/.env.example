# ==============================================================================
# Koko AI - Server Configuration (.env.example)
# Copy this file to .env and insert your API keys and configuration values.
# ==============================================================================

# --- Network & Server Settings ---
HOST=127.0.0.1
PORT=8765

# --- Operation Mode ---
# Chat mode is the standard full-duplex WebSocket browser mode (text, image, client mic).
ENABLE_CHAT_INPUT=True

# --- LLM Providers (Supported: Mistral AI & llama.cpp Gemma 4) ---
# Default provider: "mistral" or "llama_cpp"
DEFAULT_LLM_PROVIDER=mistral

# Mistral AI Settings
MISTRAL_API_KEY=your_mistral_api_key_here
DEFAULT_MISTRAL_MODEL=ministral-8b-latest

# llama.cpp Settings (for local or remote Gemma 4)
# Run with: llama-server.exe -hf ggml-org/gemma-4-E2B-it-GGUF:Q4_0 -c 8192 -ngl 0 --host 127.0.0.1 --port 8080
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q4_0
LLAMACPP_API_KEY=not-needed

# LLM Generation Parameters
CHAT_TEMPERATURE=0.7
TOOL_TEMPERATURE=0.2

# --- Agentic Tool Calling & Dynamic Discovery ---
TOOL_CALLING_ENABLED=True
MAX_TOOL_CALL_ROUNDS=20
TOOL_EXECUTION_TIMEOUT=15.0

# Tavily AI Search (for web_search & fetch_web_page tools; falls back to DuckDuckGo/HTTP if unset)
TAVILY_API_KEY=tvly-your_tavily_key_here

# --- Speech Recognition (ASR) ---
# Faster-Whisper model for streaming client microphone input (tiny.en, base.en, small.en, medium.en)
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Text-to-Speech (TTS) ---
# "fish" for Fish Audio API, "mock" for testing
TTS_BACKEND=fish
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_VOICE_ID=your_voice_id_here

# --- Subtitles & Emotion Sync ---
ENABLE_SUBTITLES=True
# "synced" = audio-segment synchronized (triggers expression when segment plays)
EMOTION_SYNC_MODE=synced

# --- Computer-Use Tools ---
# Master kill-switch for all computer-use tools (bash, file ops, process list)
COMPUTER_TOOLS_ENABLED=True
# Hard cap on bash command execution time in seconds
MAX_BASH_TIMEOUT=30
# Max file size Koko can read at once (KB)
MAX_FILE_READ_KB=128
# Max content size Koko can write at once (KB)
MAX_FILE_WRITE_KB=512
# Comma-separated list of root directories Koko is allowed to run bash from
# Leave empty to allow any directory (use with caution!)
# Example: BASH_ALLOWED_DIRS=D:/developer,C:/Users/Hp/projects
BASH_ALLOWED_DIRS=
# Comma-separated list of root directories Koko is allowed to read/write files in
# Leave empty to allow any path (use with caution!)
# Example: FILE_ALLOWED_DIRS=D:/developer,C:/Users/Hp/documents
FILE_ALLOWED_DIRS=
